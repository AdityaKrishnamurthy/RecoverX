# Database (local SQLite file — matches prisma/schema.prisma's provider)
DATABASE_URL="file:./dev.db"

# Inngest Workflow Engine (local test keys)
INNGEST_EVENT_KEY="test"
INNGEST_SIGNING_KEY="test"

# LLM Providers (Server-side only). Tried in this order until one succeeds,
# falling back to deterministic rules if all are missing/unreachable:
# Groq -> Mistral -> NVIDIA -> Gemini -> Deterministic Rules

# Groq Cloud (Active model: openai/gpt-oss-20b)
GROQ_API_KEY="gsk_..."

# Mistral AI (Active model: mistral-small-latest)
MISTRAL_API_KEY="..."

# NVIDIA Build API (Active model: nvidia/nemotron-3-nano-30b-a3b)
NVIDIA_API_KEY="nvapi-..."

# Google Gemini / AI Studio (Active model: gemini-3.6-flash)
# Also accepts GOOGLE_GENERATIVE_AI_API_KEY or GOOGLE_API_KEY
GEMINI_API_KEY="..."
