generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  segment   String   @default("STANDARD") // ENTERPRISE, SMB, VIP, STANDARD
  cases     Case[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Case {
  id                  String            @id @default(cuid())
  type                String            // PAYMENT_RETRY | CHECKOUT_ABANDONMENT | SUBSCRIPTION_FAILURE | RECEIVABLE_OVERDUE
  status              String            @default("DETECTED") // DETECTED | DIAGNOSING | INTERVENING | RECOVERED | ESCALATED | STOPPED | EXPIRED
  amount              Float
  currency            String            @default("USD")
  riskScore           Float             @default(0.5)
  diagnosis           String?
  diagnosisConfidence Float?
  recoveredAmount     Float?
  recoveredAt         DateTime?
  customerId          String
  customer            Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  events              Event[]
  interventions       Intervention[]
  auditLogs           AuditLogEntry[]
  promiseToPay        PromiseToPay?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([type])
  @@index([status])
  @@index([customerId])
}

model Event {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type      String
  payload   String   // JSON stringified payload
  createdAt DateTime @default(now())

  @@index([caseId])
}

model Intervention {
  id           String    @id @default(cuid())
  caseId       String
  case         Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type         String    // RETRY_PAYMENT | SEND_REMINDER | OFFER_INCENTIVE | REQUEST_CARD_UPDATE | ESCALATE_HUMAN
  channel      String?
  status       String    @default("PENDING")
  scheduledAt  DateTime?
  executedAt   DateTime?
  outcome      String?
  llmProvider  String?
  llmReasoning String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([caseId])
  @@index([type])
}

model AuditLogEntry {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor     String   @default("SYSTEM") // AGENT | SYSTEM
  action    String
  detail    String   // JSON stringified detail
  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([createdAt])
}

model PromiseToPay {
  id             String   @id @default(cuid())
  caseId         String   @unique
  case           Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  promisedAmount Float
  promisedDate   DateTime
  status         String   @default("PENDING") // PENDING | KEPT | BROKEN
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
